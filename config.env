# ============================================================
# iLO Monitor - Configuration
# Fill in your own values. See README.md for guidance.
# ============================================================
# --- iLO access ---
ILO_G9_IP="192.168.1.100"       # IP address of the iLO interface
ILO_G9_USER="Administrator"     # Default username on HP iLO 4
ILO_G9_PASS="yourpassword"      # The password you've set in the iLO panel
ILO_G9_NAME="DL380 G9"          # Display name in alerts - optional
# --- ntfy ---
# Full URL including topic
NTFY_URL="https://ntfy.example.com/mytopic"
# --- Cooldown ---
# Minimum number of seconds between repeated alerts for the same error
# Default: 3600 (1 hour)
ALERT_COOLDOWN=3600
